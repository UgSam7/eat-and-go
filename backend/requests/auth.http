@base=http://localhost:4001/api/auth

###
POST {{base}}/register
Content-Type: application/json

{
    "firstName": "Giovedino",
    "lastName": "Test",
    "email": "test@example.com",
    "password": "password123"
}

###
# @name login
POST {{base}}/login
Content-Type: application/json

{
    "email": "test@example.com",
    "password": "password123"
}

###
@token = {{login.response.body.token}}

GET {{base}}/me
Authorization: Bearer {{token}}
