# per usare questi file serve l'estensione REST Client
# Tutte le rotte utenti richiedono login. Ottieni il token con auth.http
# (lista ed eliminazione: solo admin; il resto: utente stesso o admin).
@base=http://localhost:4001/api/v1
@token=INCOLLA_QUI_IL_TOKEN

###
GET http://localhost:4001/

###
GET {{base}}/users
Authorization: Bearer {{token}}

###
GET {{base}}/users?page=1&perPage=10
Authorization: Bearer {{token}}

###
GET {{base}}/users?search=User
Authorization: Bearer {{token}}

###
GET {{base}}/users/68b0b54c2d143c1062d00b18
Authorization: Bearer {{token}}

###
# Solo firstName, lastName, email sono modificabili
PUT {{base}}/users/68b0b54c2d143c1062d00b18
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "lastName": "Modified",
    "email": "modified@example.com"
}

###
DELETE {{base}}/users/68ef7a3b19675b7460e58558
Authorization: Bearer {{token}}

### TEST ON POSTMAN (multipart/form-data, campo "profile")
PATCH {{base}}/users/68b0b54c2d143c1062d00b18/profile
Authorization: Bearer {{token}}
Content-Type: multipart/form-data
