PORT=4001
MONGODB_CONNECTION_URI=String_From_Atlas

CLOUDINARY_CLOUD_NAME=value
CLOUDINARY_API_KEY=value
CLOUDINARY_API_SECRET=value

JWT_SECRET=your_jwt_secret_key

GOOGLE_CLIENT_ID=google_client_id
GOOGLE_CLIENT_SECRET=google_client_secret
GOOGLE_CALLBACK_PATH=/api/auth/google/callback

BACKEND_HOST=your_backend_host
FRONTEND_HOST=your_frontend_host

CONTACT_EMAIL=your_email_gmail
CONTACT_EMAIL_PASS=your_app_password_gmail
RESEND_API_KEY=your_resend_api_key
# Opzionale: destinatario del form contatti. Se assente si usa CONTACT_EMAIL
CONTACT_TO_EMAIL=email_che_riceve_i_messaggi_del_form_contatti
# Mittente: indirizzo di un dominio verificato su Resend (es. noreply@tuodominio.it)
CONTACT_FROM_EMAIL=noreply@tuodominio.it

SUPER_ADMIN_EMAIL=super_admin_email
ADMIN_EMAILS=admin_email